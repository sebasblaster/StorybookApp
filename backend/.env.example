# Copia este archivo como .env  (nunca subas el .env real al repositorio)
# JWT_SECRET: opcional. Si lo dejas vacío se genera uno aleatorio en data/.jwt_secret
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000

# Dispositivo: auto | cuda | cpu
STORYBOOK_DEVICE=auto
# Perfil por defecto: ligero | equilibrado | calidad  (vacío = automático según GPU)
STORYBOOK_PROFILE=
# Liberar modelos entre fases: auto | true | false
STORYBOOK_KEEP_MODELS=auto
# Hilos de CPU (0 = automático)
STORYBOOK_THREADS=0
# Carpeta de la base de datos y los medios (por defecto backend/data)
# STORYBOOK_DATA_DIR=

# Descomenta DESPUÉS de descargar los modelos para garantizar cero conexiones:
# HF_HUB_OFFLINE=1
# Carpeta de caché de modelos (opcional)
# HF_HOME=
